{% comment %}
  Blank footer placeholder.
{% endcomment %}

{% style %}
  :root {
    --footer-bg: #2B241E;
    --footer-text: #FAF6F1;
    --footer-muted: #C9A87C;
    --footer-primary: #B85C38;
  }

  .footer {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 5rem);
    width: 100%;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.25rem, 5vw, 5rem);
    overflow: hidden;
    background: var(--footer-bg);
    color: var(--footer-text);
    border-radius: 1.25rem 1.25rem 0 0;
  }

  .footer__column {
    min-width: 0;
  }

  .footer h3 {
    margin: 0 0 1rem;
    color: var(--footer-text);
    font-family: Fraunces, Georgia, serif;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .footer p {
    max-width: 28rem;
    margin: 0;
    color: var(--footer-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .footer ul {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer a {
    color: var(--footer-muted);
    font-size: 0.95rem;
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--footer-text);
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid color-mix(in srgb, var(--footer-muted) 35%, transparent);
    border-radius: 999px;
  }

  .footer__social a:hover {
    background: var(--footer-primary);
    border-color: var(--footer-primary);
    text-decoration: none;
  }

  .footer__newsletter {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer__newsletter input,
  .footer__newsletter button {
    min-height: 2.9rem;
    border-radius: 0.6rem;
    font: inherit;
  }

  .footer__newsletter input {
    width: 100%;
    padding: 0.75rem 0.9rem;
    color: var(--footer-text);
    background: color-mix(in srgb, var(--footer-text) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--footer-muted) 35%, transparent);
  }

  .footer__newsletter input::placeholder {
    color: var(--footer-muted);
  }

  .footer__newsletter input:focus {
    outline: 2px solid var(--footer-primary);
    outline-offset: 2px;
  }

  .footer__newsletter button {
    padding: 0.75rem 1rem;
    color: var(--footer-text);
    background: var(--footer-primary);
    border: 1px solid var(--footer-primary);
    cursor: pointer;
  }

  .footer__newsletter button:hover {
    background: color-mix(in srgb, var(--footer-primary) 82%, var(--footer-text));
  }

  @media screen and (max-width: 749px) {
    .footer {
      grid-template-columns: 1fr;
      gap: 2.25rem;
      padding: 2.5rem 1.25rem;
    }
  }
{% endstyle %}

<footer class="footer">
  <div class="footer__column">
    <h3>About</h3>
    <p>{{ section.settings.about_text }}</p>
  </div>

  <div class="footer__column">
    <h3>Policies</h3>
    <ul>
      <li><a href="{{ shop.policies.privacy_policy.url }}">Privacy</a></li>
      <li><a href="{{ shop.policies.shipping_policy.url }}">Shipping</a></li>
      <li><a href="{{ shop.policies.return_policy.url }}">Returns</a></li>
      <li><a href="{{ shop.policies.terms_of_service.url }}">Terms</a></li>
    </ul>
  </div>

  <div class="footer__column">
    <h3>Follow</h3>
    <div class="footer__social">
      {% if section.settings.instagram_url %}
        <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">Instagram</a>
      {% endif %}
      <a href="#" target="_blank" rel="noopener">Facebook</a>
      <a href="#" target="_blank" rel="noopener">TikTok</a>
    </div>
  </div>

  <div class="footer__column">
    <h3>Newsletter</h3>
    <form method="post" action="/contact" class="footer__newsletter">
      <input type="email" name="contact[email]" placeholder="your@email.com" required>
      <button type="submit">Sign up</button>
    </form>
  </div>
</footer>

{% schema %}
{
  "name": "t:general.footer",
  "settings": []
}
{% endschema %}
