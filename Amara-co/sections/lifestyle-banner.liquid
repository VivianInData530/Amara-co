{% style %}
  .lifestyle-banner__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin: 2rem 0;
  }

  .lifestyle-banner__panel {
    position: relative;
    height: 40vh;
    overflow: hidden;
    color: var(--color-bg);
    text-decoration: none;
  }

  .lifestyle-banner__image {
    position: absolute;
    inset: 0;
    background-size: 100%;
    background-position: center;
    background-repeat: no-repeat;
    transition: background-size 0.4s ease;
  }

  .lifestyle-banner__panel:hover .lifestyle-banner__image {
    background-size: 110%;
  }

  .lifestyle-banner__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 40%;
    background: linear-gradient(to bottom, transparent, rgba(43, 36, 30, 0.7));
  }

  .lifestyle-banner__content {
    position: absolute;
    bottom: 1.5rem;
    left: 1.5rem;
    right: 1.5rem;
    z-index: 1;
    text-align: center;
  }

  .lifestyle-banner__heading {
    margin: 0 0 0.75rem;
    color: var(--color-bg);
    font-family: Fraunces, Georgia, serif;
    font-size: 1.5rem;
    font-weight: 400;
  }

  .lifestyle-banner .button--outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1.1rem;
    border: 1px solid rgba(250, 246, 241, 0.7);
    border-radius: 100px;
    color: var(--color-bg);
    background: transparent;
    font-family: Inter, sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.25s ease;
  }

  .lifestyle-banner .button--outline:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 750px) {
    .lifestyle-banner__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<section class="lifestyle-banner scroll-trigger">
  <div class="lifestyle-banner__grid">
    {%- for i in (1..3) -%}
      {% assign image_key = 'image_' | append: i %}
      {% assign heading_key = 'heading_' | append: i %}
      {% assign link_key = 'link_' | append: i %}
      {% assign button_text_key = 'button_text_' | append: i %}

      {% assign panel_image = section.settings[image_key] %}
      {% assign panel_heading = section.settings[heading_key] %}
      {% assign panel_link = section.settings[link_key] %}
      {% assign panel_button_text = section.settings[button_text_key] %}

      <a href="{{ panel_link }}" class="lifestyle-banner__panel">
        {% if panel_image %}
          <div class="lifestyle-banner__image" style="background-image: url('{{ panel_image | image_url: width: 800 }}');"></div>
        {% endif %}
        <div class="lifestyle-banner__overlay"></div>
        <div class="lifestyle-banner__content">
          <h3 class="lifestyle-banner__heading">{{ panel_heading }}</h3>
          <span class="button--outline">{{ panel_button_text }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Lifestyle banner",
  "settings": [
    { "type": "image_picker", "id": "image_1", "label": "Panel 1 image" },
    { "type": "text", "id": "heading_1", "label": "Panel 1 heading", "default": "The Everyday Edit" },
    { "type": "url", "id": "link_1", "label": "Panel 1 link" },
    { "type": "text", "id": "button_text_1", "label": "Panel 1 button text", "default": "Shop the edit" },

    { "type": "image_picker", "id": "image_2", "label": "Panel 2 image" },
    { "type": "text", "id": "heading_2", "label": "Panel 2 heading", "default": "New Arrivals" },
    { "type": "url", "id": "link_2", "label": "Panel 2 link" },
    { "type": "text", "id": "button_text_2", "label": "Panel 2 button text", "default": "Shop new in" },

    { "type": "image_picker", "id": "image_3", "label": "Panel 3 image" },
    { "type": "text", "id": "heading_3", "label": "Panel 3 heading", "default": "Gifting, Made Easy" },
    { "type": "url", "id": "link_3", "label": "Panel 3 link" },
    { "type": "text", "id": "button_text_3", "label": "Panel 3 button text", "default": "Shop gifts" }
  ],
  "presets": [
    { "name": "Lifestyle banner" }
  ]
}
{% endschema %}