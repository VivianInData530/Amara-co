<div id="cart-drawer" class="cart-drawer" hidden data-cart-drawer>
  <div class="cart-drawer__header">
    <h2>Your Cart</h2>
    <button class="cart-drawer__close" aria-label="Close cart" onclick="closeCartDrawer();">×</button>
  </div>

  <div id="cart-items-container" class="cart-drawer__items">
    {%- for item in cart.items -%}
      <div class="cart-item" data-cart-item-key="{{ forloop.index }}">
        <a href="{{ item.url }}" class="cart-item__image">
  {% if item.image %}
    <img
      srcset="
        {{ item.image | image_url: width: 80 }} 80w,
        {{ item.image | image_url: width: 160 }} 160w
      "
      sizes="80px"
      src="{{ item.image | image_url: width: 160 }}"
      alt="{{ item.title | escape }}"
      width="160"
      height="160"
      loading="lazy"
    >
  {% endif %}
</a>
        <div class="cart-item__details">
          <a href="{{ item.url }}" class="cart-item__title">{{ item.title }}</a>
          <p class="cart-item__variant">{{ item.variant_title }}</p>
          <p class="cart-item__price">{{ item.price | money }}</p>
        </div>
        <div class="cart-item__qty">
         <button type="button" onclick="updateQuantity('{{ item.key }}', {{ item.quantity }} - 1);">−</button>
<input type="number" value="{{ item.quantity }}" readonly>
<button type="button" onclick="updateQuantity('{{ item.key }}', {{ item.quantity }} + 1);">+</button>
        </div>
        <button type="button" class="cart-item__remove" onclick="removeItem('{{ item.key }}');">Remove</button>
      </div>
    {%- endfor -%}
  </div>

  {% if cart.item_count > 0 %}
    <div class="cart-drawer__footer">
      <div class="cart-drawer__subtotal"><span>Subtotal:</span><span id="cart-subtotal">{{ cart.total_price | money }}</span></div>
      {% if cart.total_price < 10000 %}
        <div class="free-shipping-progress">
          <p>Free shipping on orders over $100</p>
          <div class="progress-bar"><div class="progress-fill" style="width: {{ cart.total_price | divided_by: 10000 | times: 100 }}%;"></div></div>
        </div>
      {% endif %}
      <a href="/checkout" class="button button--primary">Proceed to Checkout</a>
      <button onclick="closeCartDrawer();" class="button button--secondary">Continue Shopping</button>
    </div>
  {% else %}
    <div class="cart-drawer__empty">
      <p>Your cart is empty</p>
      <button onclick="closeCartDrawer();" class="button button--secondary">Continue Shopping</button>
    </div>
  {% endif %}
</div>

{% style %}
  .cart-drawer {
    --cart-line: color-mix(in srgb, var(--color-text) 14%, transparent);
  

    position: fixed;
    inset: 0 0 0 auto;
    z-index: 1000;
    display: flex;
    width: min(100%, 460px);
    height: 100dvh;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-background);
    color: var(--color-text);
    box-shadow: -1.5rem 0 4rem color-mix(
      in srgb,
      var(--color-text) 18%,
      transparent
    );
    /* transform: translateX(100%);
    transition: transform 320ms cubic-bezier(.22, 1, .36, 1); */
  }

  .cart-drawer.active {
    transform: translateX(0);
  }

  .cart-drawer__header {
    display: flex;
    min-height: 5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--cart-line);
  }

  .cart-drawer__header h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 5vw, 2.3rem);
    font-weight: 400;
    letter-spacing: -0.045em;
  }

  .cart-drawer__close {
    display: inline-flex;
    width: 2.6rem;
    height: 2.6rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--cart-line);
    border-radius: 999px;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    font-size: 1.35rem;
    line-height: 1;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .cart-drawer__close:hover {
    background: var(--color-primary);
    color: var(--color-background);
    transform: rotate(8deg) scale(1.04);
  }

  .cart-drawer__items {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem 1.5rem;
    scrollbar-width: thin;
  }

  .cart-item {
    display: grid;
    grid-template-columns: 82px minmax(0, 1fr);
    gap: 0.9rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--cart-line);
  }

  .cart-item__image {
    display: block;
    width: 82px;
    height: 104px;
    overflow: hidden;
    border-radius: 0.8rem;
    background: var(--cart-soft);
  }

  .cart-item__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 250ms ease;
  }

  .cart-item__image:hover img {
    transform: scale(1.06);
  }

  .cart-item__details {
    min-width: 0;
  }

  .cart-item__title {
    display: block;
    margin: 0 0 0.3rem;
    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.35;
    text-decoration: none;
  }

  .cart-item__title:hover {
    color: var(--color-primary);
  }

  .cart-item__variant,
  .cart-item__price {
    margin: 0.25rem 0;
    color: var(--color-muted);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .cart-item__price {
    color: var(--color-primary);
    font-weight: 700;
  }

  .cart-item__qty {
    display: inline-flex;
    width: fit-content;
    min-height: 2.35rem;
    align-items: center;
    gap: 0.2rem;
    margin-top: 0.55rem;
    padding: 0.2rem;
    border: 1px solid var(--cart-line);
    border-radius: 999px;
    background: var(--cart-soft);
  }

  .cart-item__qty button {
    display: inline-flex;
    width: 1.9rem;
    height: 1.9rem;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    font-size: 1rem;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .cart-item__qty button:hover {
    background: var(--color-primary);
    color: var(--color-background);
    transform: scale(1.08);
  }

  .cart-item__qty input {
    width: 2rem;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--color-text);
    font-size: 0.8rem;
    text-align: center;
  }

  .cart-item__remove {
    grid-column: 2;
    width: fit-content;
    margin-top: 0.45rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    font-size: 0.75rem;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .cart-item__remove:hover {
    color: var(--color-primary);
  }

  .cart-drawer__footer {
    padding: 1.25rem 1.5rem 1.5rem;
    border-top: 1px solid var(--cart-line);
    background: var(--cart-soft);
  }

  .cart-drawer__subtotal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    font-size: 1rem;
    font-weight: 700;
  }

  #cart-subtotal {
    color: var(--color-primary);
    font-size: 1.2rem;
  }

  .free-shipping-progress {
    margin-bottom: 1.25rem;
  }

  .free-shipping-progress p {
    margin: 0 0 0.6rem;
    color: var(--color-muted);
    font-size: 0.78rem;
  }

  .progress-bar {
    height: 0.45rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--cart-line);
  }

  .progress-fill {
    height: 100%;
    border-radius: inherit;
    background: var(--color-primary);
    transition: width 300ms ease;
  }

  .cart-drawer .button {
    display: flex;
    width: 100%;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    margin-top: 0.7rem;
    border-radius: 0.75rem;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .cart-drawer .button:hover {
    transform: scale(1.015);
  }

  .cart-drawer .button--primary {
    border: 1px solid var(--color-primary);
    background: var(--color-primary);
    color: var(--color-background);
  }

  .cart-drawer .button--secondary {
    border: 1px solid var(--cart-line);
    background: transparent;
    color: var(--color-text);
  }

  .cart-drawer .button--secondary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .cart-drawer__empty {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: 2rem;
    text-align: center;
  }

  .cart-drawer__empty p {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 2.2rem;
    font-weight: 400;
    letter-spacing: -0.04em;
  }

  .cart-drawer button:focus-visible,
  .cart-drawer a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  @media screen and (max-width: 750px) {
    .cart-drawer {
      width: 100%;
    }

    .cart-drawer__header,
    .cart-drawer__items,
    .cart-drawer__footer {
      padding-inline: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-drawer,
    .cart-drawer * {
      transition: none;
    }
  }
{% endstyle %}


