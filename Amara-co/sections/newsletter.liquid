{% style %}
  .newsletter {
    padding: 4rem 1.5rem;
  }

  .newsletter__container {
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
    padding: 3.5rem 2.5rem;
    background: var(--color-text);
    border-radius: 20px;
    position: relative;
    overflow: hidden;
  }

  .newsletter__container::before {
    content: "✦";
    display: block;
    font-size: 1.5rem;
    color: var(--color-secondary);
    margin-bottom: 1rem;
  }

  .newsletter__heading {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 400;
    margin-bottom: 0.75rem;
    color: var(--color-bg);
  }

  .newsletter__description {
    margin-bottom: 2rem;
    color: var(--color-bg);
    font-family: var(--font-body);
    opacity: 0.75;
    font-size: 0.95rem;
  }

  .newsletter__form {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 0;
    max-width: 380px;
    margin: 0 auto;
    background: var(--color-bg);
    border-radius: 100px;
    padding: 0.35rem 0.35rem 0.35rem 1.25rem;
  }

  .newsletter__input {
    flex: 1;
    border: none;
    background: transparent;
    padding: 0.6rem 0.5rem;
    font-family: var(--font-body);
    color: var(--color-text);
    min-width: 0;
  }

  .newsletter__input::placeholder {
    color: var(--color-muted);
  }

  .newsletter__input:focus {
    outline: none;
  }

  .newsletter__button {
    flex-shrink: 0;
    background: var(--color-primary);
    border: none;
    color: var(--color-bg);
    cursor: pointer;
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.7rem 1.4rem;
    border-radius: 100px;
    transition: transform 0.2s ease;
  }

  .newsletter__button:hover {
    transform: translateY(-1px);
  }

  @media (max-width: 480px) {
    .newsletter__container {
      padding: 2.5rem 1.5rem;
    }

    .newsletter__form {
      flex-direction: column;
      background: transparent;
      padding: 0;
      gap: 0.75rem;
    }

    .newsletter__input {
      background: var(--color-bg);
      border-radius: 100px;
      padding: 0.75rem 1.25rem;
    }

    .newsletter__button {
      width: 100%;
    }
  }
{% endstyle %}

<section class="newsletter scroll-trigger animate--fade-in">
  <div class="newsletter__container">
    <span aria-hidden="true"></span>
    <h2 class="newsletter__heading">{{ section.settings.heading }}</h2>
    <p class="newsletter__description">{{ section.settings.description }}</p>
    <form method="POST" action="/contact" class="newsletter__form">
      <input type="email" name="contact[email]" placeholder="your@email.com" required class="newsletter__input">
      <button type="submit" class="newsletter__button">{{ section.settings.button_text }}</button>
    </form>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stay close to the studio" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "New arrivals, restocks, and quiet studio notes — nothing else." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Sign up" }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}