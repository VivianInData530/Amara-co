<section class="best-sellers scroll-trigger animate--fade-in">

  <div class="best-sellers__header">
    <h2 class="section-title">Best Sellers</h2>
  </div>

  {% if section.settings.collection %}

    <div class="carousel" data-carousel>

      <div class="carousel__track">

        {% for product in section.settings.collection.products limit: 8 %}

          <div class="carousel__slide">

            <a href="{{ product.url }}" class="product-card">

              <div class="product-card__image-container">

                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 400 }}"
                    alt="{{ product.featured_image.alt | default: product.title }}"
                    class="product-card__image product-card__image--primary"
                    width="400"
                    height="400"
                    loading="lazy"
                  >
                {% endif %}

                {% if product.images[1] %}
                  <img
                    src="{{ product.images[1] | image_url: width: 400 }}"
                    alt="{{ product.title }} alternate view"
                    class="product-card__image product-card__image--hover"
                    width="400"
                    height="400"
                    loading="lazy"
                  >
                {% endif %}

              </div>

              <h3 class="product-card__title">
                {{ product.title }}
              </h3>

              <div class="product-card__price">

                {% if product.compare_at_price > product.price %}

                  <span class="price-regular">
                    {{ product.compare_at_price | money }}
                  </span>

                  <span class="price-sale">
                    {{ product.price | money }}
                  </span>

                {% else %}

                  <span class="price-current">
                    {{ product.price | money }}
                  </span>

                {% endif %}

              </div>

            </a>

          </div>

        {% endfor %}

      </div>

    </div>

    <button
      class="carousel__arrow carousel__arrow--prev"
      type="button"
      aria-label="Previous products"
    >
      ←
    </button>

    <button
      class="carousel__arrow carousel__arrow--next"
      type="button"
      aria-label="Next products"
    >
      →
    </button>

  {% else %}

    <p class="best-sellers__empty">
      Select a collection to display best sellers.
    </p>

  {% endif %}

</section>


{% style %}

  .best-sellers {
    width: 100%;
    padding: 3rem 1.5rem;
    position: relative;
  }

  .best-sellers__header {
    margin-bottom: 1.5rem;
  }

  .section-title {
    margin: 0;
    font-family: var(--font-serif);
    color: var(--color-text);
    text-align: center;
  }


  /* Carousel */

  .carousel {
    width: 100%;
    overflow: hidden;
  }

  .carousel__track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 0.5rem 0 1rem;

    scrollbar-width: thin;
  }

  .carousel__track::-webkit-scrollbar {
    height: 6px;
  }

  .carousel__track::-webkit-scrollbar-thumb {
    background: var(--color-muted);
    border-radius: 999px;
  }

  .carousel__slide {
    flex: 0 0 250px;
    scroll-snap-align: start;
  }


  /* Product card */

  .product-card {
    display: block;
    color: var(--color-text);
    text-decoration: none;
  }

  .product-card__image-container {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 16px;
    background-color: #f5f0eb;
  }

  .product-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--duration-default) ease;
  }

  .product-card__image--primary {
    opacity: 1;
  }

  .product-card__image--hover {
    opacity: 0;
  }

  .product-card:hover .product-card__image--primary {
    opacity: 0;
  }

  .product-card:hover .product-card__image--hover {
    opacity: 1;
  }

  .product-card__title {
    margin: 0.75rem 0 0.4rem;
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--color-text);
  }

  .product-card__price {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
  }

  .price-regular {
    color: var(--color-muted);
    text-decoration: line-through;
  }

  .price-sale {
    color: var(--color-primary);
    font-weight: 600;
  }

  .price-current {
    color: var(--color-text);
  }


  /* Carousel arrows
     Buttons are prepared for JavaScript in the next step.
  */

  .carousel__arrow {
    position: absolute;
    top: 50%;
    z-index: 2;

    width: 42px;
    height: 42px;

    border: none;
    border-radius: 50%;

    background: var(--color-bg);
    color: var(--color-text);

    cursor: pointer;

    box-shadow: 0 2px 10px rgba(43, 36, 30, 0.12);

    transform: translateY(-50%);

    transition:
      transform var(--duration-fast) ease,
      background-color var(--duration-fast) ease;
  }

  .carousel__arrow:hover {
    transform: translateY(-50%) scale(1.05);
  }

  .carousel__arrow--prev {
    left: 0.5rem;
  }

  .carousel__arrow--next {
    right: 0.5rem;
  }


  /* Empty state */

  .best-sellers__empty {
    text-align: center;
    color: var(--color-muted);
    margin: 2rem 0;
  }


  /* Mobile */

  @media (max-width: 750px) {

    .best-sellers {
      padding: 2rem 1rem;
    }

    .carousel__slide {
      flex: 0 0 150px;
    }

    .carousel__track {
      gap: 1rem;
    }

    .carousel__arrow {
      width: 36px;
      height: 36px;
    }

      .product-card__image--primary {
    opacity: 0;
  }

  .product-card__image--hover {
    opacity: 1;
  }

  }

{% endstyle %}


{% schema %}
{
  "name": "Best sellers",

  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],

  "presets": [
    {
      "name": "Best sellers"
    }
  ]
}
{% endschema %}