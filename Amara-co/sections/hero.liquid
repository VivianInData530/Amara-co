{% style %}
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(85vh, 760px);
    width: 100%;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-bg);
  }

  .hero > img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(43, 36, 30, 0.25) 40%,
      rgba(43, 36, 30, 0.75) 100%
    );
  }

  .hero__content {
    width: min(100%, 640px);
    padding: clamp(2rem, 6vw, 5rem);
    animation: hero-slide-up 200ms ease both;
    animation-timeline: view();
    animation-range: entry 0% cover 25%;
  }

  .hero__eyebrow {
    margin: 0 0 0.75rem;
    color: #ffffffc5;
    font-family: Inter, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }

  .hero__headline {
    max-width: 12ch;
    margin: 0 0 1rem;
    color: #ffffffc5;
    font-family: Fraunces, Georgia, serif;
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.02;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }

  .hero__description {
    max-width: 26rem;
    margin: 0 0 1.5rem;
    color: #ffffffc5;
    font-family: Inter, sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.95;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }

  .hero__buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .hero .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.9rem;
    padding: 0.75rem 1.25rem;
    border-radius: 100px;
    font-family: Inter, sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    transition: transform 0.25s ease;
  }

  .hero .button:hover {
    transform: translateY(-2px);
  }

  .hero .button--primary {
    color: var(--color-text);
    background: #FFFFFF;
    border: 1px solid #FFFFFF;
  }

  .hero .button--secondary {
    color: #ffffffc5;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.7);
  }

  @keyframes hero-slide-up {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 749px) {
    .hero {
      min-height: 72vh;
    }

    .hero__content {
      padding: 2rem 1.25rem;
    }

    .hero__headline {
      max-width: 14ch;
    }

    .hero__buttons {
      flex-direction: column;
      align-items: stretch;
    }

    .hero .button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__content {
      animation: none;
    }
  }
{% endstyle %}
<section class="hero scroll-trigger animate--fade-in" data-hero>
  {% if section.settings.image %}
    <img
      srcset="
        {{ section.settings.image | image_url: width: 600 }} 600w,
        {{ section.settings.image | image_url: width: 1200 }} 1200w,
        {{ section.settings.image | image_url: width: 1800 }} 1800w
      "
      sizes="100vw"
      src="{{ section.settings.image | image_url: width: 1200 }}"
      alt="{{ section.settings.image.alt }}"
      width="{{ section.settings.image.width }}"
      height="{{ section.settings.image.height }}"
      loading="eager"
    >
  {% endif %}

  <div class="hero__overlay"></div>

  <div class="hero__content">
    {% if section.settings.eyebrow %}
      <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1 class="hero__headline">{{ section.settings.headline }}</h1>
    {% if section.settings.description %}
      <p class="hero__description">{{ section.settings.description }}</p>
    {% endif %}
    <div class="hero__buttons">
      <a href="{{ section.settings.button1_link }}" class="button button--primary">{{ section.settings.button1_text }}</a>
      <a href="{{ section.settings.button2_link }}" class="button button--secondary">{{ section.settings.button2_text }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Elevate Your Style" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "text", "id": "button1_text", "label": "Button 1 text" },
    { "type": "url", "id": "button1_link", "label": "Button 1 link" },
    { "type": "text", "id": "button2_text", "label": "Button 2 text" },
    { "type": "url", "id": "button2_link", "label": "Button 2 link" }
  ]
}
{% endschema %}