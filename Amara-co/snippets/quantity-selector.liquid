<div class="quantity-selector">
  <button class="quantity-selector__button" onclick="this.parentElement.querySelector('input').value = Math.max(1, parseInt(this.parentElement.querySelector('input').value) - 1);">−</button>
  <input type="number" name="quantity" value="{{ quantity | default: 1 }}" min="1" max="999" class="quantity-selector__input">
  <button class="quantity-selector__button" onclick="this.parentElement.querySelector('input').value = parseInt(this.parentElement.querySelector('input').value) + 1;">+</button>
</div>

{% style %}
  .quantity-selector { display: flex; gap: 0.5rem; align-items: center; border: 1px solid var(--color-muted); border-radius: 4px; padding: 0.25rem; width: fit-content; }
  .quantity-selector__button { width: 30px; height: 30px; border: none; background: none; cursor: pointer; font-size: 1rem; }
  .quantity-selector__button:hover { background-color: #f5f5f5; }
  .quantity-selector__input { width: 50px; text-align: center; border: none; outline: none; font-size: 0.9rem; }
{% endstyle %}