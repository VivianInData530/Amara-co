{% style %}
  :root {
 --color-background: #f5f5f5;
--color-foreground: #2B241E;
    --color-primary: #B85C38;
    --color-secondary: #C9A87C;
    --color-muted: #8A7F72;

    --font-body: 'Inter', sans-serif;
    --font-heading: 'Fraunces', serif;

    --page-width: 100%;
--page-margin: 0px;
--content-margin: 0px;

    --container-width: 1200px;
    --radius-sm: 4px;
    --radius-md: 8px;
    --transition: 200ms ease;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    font-size: 16px;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    padding: 0;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 0.01em;
  }

  .shopify-section {
  background: transparent;
}

  h1,
  h2,
  h3 {
    margin: 0 0 1rem;
    color: var(--color-text);
    font-family: var(--font-heading);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  h3 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  p {
    margin: 0 0 1rem;
  }

  a {
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--transition);
  }

  a:hover {
    color: var(--color-text);
  }

  img,
  video,
  svg {
    display: block;
    max-width: 100%;
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
  }

  button {
    cursor: pointer;
  }

  ul,
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .container {
    width: min(100% - 2rem, var(--container-width));
    margin-inline: auto;
  }

  .text-center {
    text-align: center;
  }

  .text-left {
    text-align: left;
  }

  .text-right {
    text-align: right;
  }

  .visually-hidden,
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--color-text);
    color: var(--color-bg);
  }

  .skip-link:focus {
    top: 1rem;
  }

  @media screen and (min-width: 750px) {
    .container {
      width: min(100% - 4rem, var(--container-width));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
{% endstyle %}