<nav class="breadcrumbs" aria-label="Breadcrumbs">
  <ol>
    <li><a href="/">Home</a></li>
    {% if template == 'product' %}
      <li><a href="/collections/{{ product.collections.first.handle }}">{{ product.collections.first.title }}</a></li>
      <li>{{ product.title }}</li>
    {% elsif template == 'collection' %}
      <li>{{ collection.title }}</li>
    {% endif %}
  </ol>
</nav>

{% style %}
  .breadcrumbs { margin: 1rem 0; font-size: 0.875rem; }
  .breadcrumbs ol { display: flex; gap: 0.5rem; list-style: none; padding: 0; }
  .breadcrumbs li::after { content: ' / '; margin: 0 0.5rem; color: var(--color-muted); }
  .breadcrumbs li:last-child::after { content: ''; }
  .breadcrumbs li:last-child { color: var(--color-muted); }
{% endstyle %}